import unittest
from EmotionDetection.emotion_detection import emotion_detector

class Test_Emotion(unittest.TestCase):
    #joy
    def test_joy(self):
        emotion = emotion_detector(" I am glad this happened")
        emotion = list(emotion.values())[5]
        self.assertEqual(emotion, 'joy')
        print (f"The resulting emotion of 'I am glad this happened' is '{emotion}'")

    #anger
    def test_anger(self):
        emotion = emotion_detector(" I am really mad about this")
        emotion = list(emotion.values())[5]
        self.assertEqual(emotion, 'anger')
        print (f"The resulting emotion of 'I am really mad about this' is '{emotion}'")

    #disgust
    def test_disgust(self):
        emotion = emotion_detector(" I feel disgusted just hearing about this")
        emotion = list(emotion.values())[5]
        self.assertEqual(emotion, 'disgust')
        print (f"The resulting emotion of 'I feel disgusted just hearing about this' is '{emotion}'")

    #sadness
    def test_sadness(self):
        emotion = emotion_detector(" I am so sad about this")
        emotion = list(emotion.values())[5]
        self.assertEqual(emotion, 'sadness')
        print (f"The resulting emotion of 'I am so sad about this' is '{emotion}'")
    
    #fear
    def test_fear(self):
        emotion = emotion_detector(" I am really afraid that this will happen ")
        emotion = list(emotion.values())[5]
        self.assertEqual(emotion, 'fear')
        print (f"The resulting emotion of 'I am really afraid that this will happen'is '{emotion}'")


if __name__ == "__main__":
    unittest.main()
