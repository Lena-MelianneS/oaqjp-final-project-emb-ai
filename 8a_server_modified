"""Import Flask and necessary package"""
from flask import Flask, request, render_template
from EmotionDetection.emotion_detection import emotion_detector

app = Flask("Emotion Predictor")

"""App route for home"""
@app.route('/')
def render_index_page():
    """Sends client to the main page"""
    return render_template('index.html')


@app.route('/emotionDetector', methods =['GET'])

def emotion_ai():
    """Placeholder for submitted text which uses reuqest to get
    the emotion_detector function from EmotionDetection folder"""

    sentence = request.args.get('textToAnalyze')
    result = emotion_detector(sentence)

    if result['dominant_emotion'] is None:
        return "Invalid text ! Please try again"
    return f"For the given statement, the system response is {result}"

if __name__ == "__main__":
    app.run(host = "0.0.0.0", port = 5000)

